# ==============================================================================
# MEDISLOT FULL-STACK ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to backend/.env and frontend/.env respectively
# ==============================================================================

# Backend Configuration (backend/.env)
PORT=5000
NODE_ENV=development
DATABASE_PATH=./medislot.db
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=24h
FRONTEND_ORIGIN=http://localhost:5173

# Initial Admin Bootstrap Credentials (Run `npm run seed:admin` in backend)
ADMIN_DEFAULT_EMAIL=admin@medislot.gov.in
ADMIN_DEFAULT_PASSWORD=AdminSecure@2026
ADMIN_DEFAULT_NAME=Chief Medical Administrator
ADMIN_DEFAULT_PHONE=9848099999

# Frontend Configuration (frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api/v1
